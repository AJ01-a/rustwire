  "tldr": [
    {
      "source": "hackernews",
      "subsource": "news.ycombinator.com",
      "category": "ai",
      "title": "Vomit: Clean up Claude 5's token output with a separate LLM",
      "url": "https://github.com/zachahn/vomit",
      "discuss_url": "https://news.ycombinator.com/item?id=49375996",
      "score": 269,
      "comments": 264,
      "author": "Bluestein",
      "published": "2026-08-20T15:26:02Z",
      "bullets": [
        "Secondary LLMs act as dedicated sanitization layers to strip verbose boilerplate, unwanted tokens, and artifacts from primary model generations.",
        "Chaining smaller, fast models after frontier Claude outputs improves schema adherence and structural consistency for downstream applications.",
        "Decoupling generation from formatting reduces prompt engineering overhead on primary models while adding minimal multi-model pipeline latency."
      ]
