  "tldr": [
    {
      "source": "hackernews",
      "subsource": "news.ycombinator.com",
      "category": "ai",
      "title": "Show HN: Needle2: 14MB agentic LLM for phones, wearables, smart home and robots",
      "url": "https://cactuscompute.com/needle",
      "discuss_url": "https://news.ycombinator.com/item?id=49246804",
      "score": 292,
      "comments": 106,
      "author": "HenryNdubuaku",
      "published": "2026-08-10T17:22:07Z",
      "bullets": [
        "Needle 2 is a 45M-parameter, 2-bit quantized LLM operating as a 14MB binary using 28MB RAM via Simple Attention Networks.",
        "Decodes at 500 tokens/sec on Raspberry Pi 5 and 400–1,500 tokens/sec on Meta Quest 3S and Apple Vision Pro.",
        "Matches tool-calling benchmarks of larger models like LFM2.5 230M and Apple Foundation Model at 5x to 70x smaller sizes."
      ]
    },
    {
      "source": "lobsters",
      "subsource": "lobste.rs/programming",
      "category": "engineering",
      "title": "What are you doing this week?",
      "url": "https://lobste.rs/s/3qwloh",
